# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=premier_league
POSTGRES_USER=pl_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Application (préfixe PL_) ---
# En local hors Docker, l'hôte est localhost ; dans Docker il est surchargé par "postgres".
PL_DB_HOST=localhost
PL_DB_PORT=5432
PL_DB_NAME=premier_league
PL_DB_USER=pl_user
PL_DB_PASSWORD=change_me
PL_DATA_DIR=data
PL_LOG_LEVEL=INFO

# Périmètre : 2016-17 -> 2026-27 (saison en cours)
PL_FIRST_SEASON=2016
PL_CURRENT_SEASON=2026

# Optionnel : API-Football (api-sports.io) pour enrichir arbitres / stats live
PL_API_FOOTBALL_KEY=

# pgAdmin (profil "tools")
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# Base hébergée (Neon, Supabase) : PL_DB_SSLMODE=require
PL_DB_SSLMODE=prefer
